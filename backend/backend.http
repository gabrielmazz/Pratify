# backend.http -> Colecao de testes HTTP local para autenticacao.
#
# COMO USAR
# 1) Suba o backend (dotnet run).
# 2) Execute primeiro o register (ou use login se usuario ja existir).
# 3) Copie o token retornado no login e atribua na variavel {{token}}.
# 4) Execute /api/users/me para carregar o perfil completo do usuario autenticado.

@backend_HostAddress = http://localhost:5017
@token = COLE_SEU_TOKEN_AQUI

###
# Registro de novo usuario.
POST {{backend_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Gabriel",
  "email": "gabriel@example.com",
  "password": "123456"
}

###
# Login com email/senha.
POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "gabriel@example.com",
  "password": "123456"
}

###
# Endpoint protegido.
# Precisa enviar Authorization: Bearer <token>
GET {{backend_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}
Accept: application/json

###
# Endpoint principal de perfil (recomendado).
# Precisa enviar Authorization: Bearer <token>
GET {{backend_HostAddress}}/api/users/me
Authorization: Bearer {{token}}
Accept: application/json

###
# Atualiza perfil do usuario autenticado.
POST {{backend_HostAddress}}/api/users/me
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "birthDate": "1990-10-25T00:00:00.000Z",
  "institution": "Universidade Exemplo",
  "crn": "CRN-12345",
  "city": "Curitiba",
  "state": "PR"
}

###
# Upload de foto de perfil (multipart/form-data).
POST {{backend_HostAddress}}/api/users/me/profile-picture
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Accept: application/json

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="profile.jpg"
Content-Type: image/jpeg

< ./profile.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###
# Consulta de modelos carregados no Ollama via backend.
GET {{backend_HostAddress}}/api/ai/models
Authorization: Bearer {{token}}
Accept: application/json

###
# Chat com IA (Ollama) via backend.
POST {{backend_HostAddress}}/api/ai/chat
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "prompt": "Crie uma sugestao de cafe da manha para paciente com foco em ganho muscular.",
  "model": "qwen2.5:7b-instruct"
}

###
